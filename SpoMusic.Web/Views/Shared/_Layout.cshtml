@{
    var username = Context.Request.Cookies["spomusic_username"];
    var userimage = Context.Request.Cookies["spomusic_userimage"];
    var isLoggedIn = !string.IsNullOrEmpty(Context.Request.Cookies["spomusic_token"]);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SpoMusic | Müzik Ruh Eşini Keşfet</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar-custom">
            <div class="nav-container">
                <a class="brand-logo" asp-controller="Home" asp-action="Index">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.58 14.42c-.18.3-.57.4-.87.21-2.4-1.47-5.43-1.8-9-1-.34.08-.68-.13-.76-.47-.08-.34.13-.68.47-.76 3.92-.89 7.28-.52 9.95 1.15.3.19.4.58.21.87zm1.22-2.72c-.23.37-.72.49-1.09.26-2.75-1.69-6.94-2.18-10.19-1.19-.42.13-.86-.11-.99-.53-.13-.42.11-.86.53-.99 3.71-1.13 8.35-.58 11.48 1.36.38.23.49.72.26 1.09zm.11-2.83C14.62 8.9 9.17 8.72 6.01 9.68c-.5.15-1.04-.13-1.19-.63-.15-.5.13-1.04.63-1.19 3.66-1.11 9.69-.9 13.5 1.36.46.27.61.87.34 1.33-.27.46-.87.61-1.38.32z"/>
                    </svg>
                    <span>SpoMusic</span>
                </a>

                <div class="nav-links">
                    <a class="nav-link-item" asp-controller="Home" asp-action="Index">Keşfet</a>
                    <a class="nav-link-item" asp-controller="Matches" asp-action="Index">Eşleşmeler</a>
                    <a class="nav-link-item" asp-controller="Profile" asp-action="Index">Profil</a>
                    <a class="nav-link-item" asp-controller="Settings" asp-action="Index">Ayarlar</a>

                    @if (isLoggedIn)
                    {
                        <div style="display: flex; align-items: center; gap: 0.8rem; margin-left: 0.5rem;">
                            @if (!string.IsNullOrEmpty(userimage))
                            {
                                <img src="@userimage" alt="Profile" style="width: 34px; height: 34px; border-radius: 50%; border: 1.5px solid var(--spotify-green);" />
                            }
                            <span style="font-size: 0.9rem; font-weight: 600;">@username</span>
                            <a asp-controller="Auth" asp-action="Logout" class="nav-link-item" style="color: #ef4444; font-size: 0.85rem;">Çıkış</a>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn-spotify">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.58 14.42c-.18.3-.57.4-.87.21-2.4-1.47-5.43-1.8-9-1-.34.08-.68-.13-.76-.47-.08-.34.13-.68.47-.76 3.92-.89 7.28-.52 9.95 1.15.3.19.4.58.21.87zm1.22-2.72c-.23.37-.72.49-1.09.26-2.75-1.69-6.94-2.18-10.19-1.19-.42.13-.86-.11-.99-.53-.13-.42.11-.86.53-.99 3.71-1.13 8.35-.58 11.48 1.36.38.23.49.72.26 1.09zm.11-2.83C14.62 8.9 9.17 8.72 6.01 9.68c-.5.15-1.04-.13-1.19-.63-.15-.5.13-1.04.63-1.19 3.66-1.11 9.69-.9 13.5 1.36.46.27.61.87.34 1.33-.27.46-.87.61-1.38.32z"/>
                            </svg>
                            Giriş Yap
                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <!-- Floating Audio Preview Bar -->
    <div id="playerBar" class="audio-player-bar">
        <div class="player-track-info">
            <img id="playerThumb" class="player-thumb" src="" alt="Album Art" />
            <div class="player-text">
                <div id="playerName" class="name">Şarkı Adı</div>
                <div id="playerArtist" class="artist">Sanatçı</div>
            </div>
        </div>
        <div>
            <button onclick="toggleAudio()" style="background: none; border: none; font-size: 1.6rem; cursor: pointer; color: #fff;">
                <span id="playIcon">⏸</span>
            </button>
        </div>
    </div>

    <!-- Toast Message -->
        <div id="toastBox" class="toast-box"></div>

    <!-- Same Song Live Notification Toast Container -->
    <div id="sameSongToastContainer" class="same-song-toast-container"></div>

    @if (isLoggedIn)
    {
        <script>
            (function() {
                const dismissedMap = new Map();

                function playSoftChime() {
                    try {
                        const AudioContext = window.AudioContext || window.webkitAudioContext;
                        if (!AudioContext) return;
                        const ctx = new AudioContext();
                        
                        const osc = ctx.createOscillator();
                        const gain = ctx.createGain();

                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(587.33, ctx.currentTime);
                        osc.frequency.exponentialRampToValueAtTime(880.00, ctx.currentTime + 0.15);

                        gain.gain.setValueAtTime(0.08, ctx.currentTime);
                        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.45);

                        osc.connect(gain);
                        gain.connect(ctx.destination);

                        osc.start();
                        osc.stop(ctx.currentTime + 0.45);
                    } catch (e) {}
                }

                function showSameSongToast(listener, trackName, artists) {
                    const key = listener.userId + '_' + listener.trackId;
                    const now = Date.now();
                    if (dismissedMap.has(key) && (now - dismissedMap.get(key) < 120000)) {
                        return;
                    }

                    const container = document.getElementById('sameSongToastContainer');
                    if (!container) return;

                    if (document.getElementById('toast_' + key)) return;

                    playSoftChime();

                    const toast = document.createElement('div');
                    toast.id = 'toast_' + key;
                    toast.className = 'same-song-toast';

                    const avatar = listener.image || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=120';
                    const artistStr = (artists && artists.length) ? artists.join(', ') : (listener.artists ? listener.artists.join(', ') : '');

                    toast.innerHTML = `
                        <div class="same-song-header">
                            <div class="same-song-title">
                                <span class="pulse-dot"></span>
                                <span>Aynı Şarkıdasınız!</span>
                            </div>
                            <span style="font-size: 0.72rem; color: var(--spotify-green); font-weight: 600;">Şu Anda Canlı</span>
                        </div>
                        <div class="same-song-body">
                            <img src="${avatar}" alt="${listener.name}" class="same-song-avatar" />
                            <div class="same-song-info">
                                <div class="same-song-user">${listener.name}</div>
                                <div class="same-song-text">
                                    seninle birlikte <span class="same-song-track">${trackName}</span> dinliyor! 🎧
                                </div>
                            </div>
                        </div>
                        <div class="same-song-actions">
                            <a href="/profile?userId=${encodeURIComponent(listener.userId)}" class="btn-toast-profile">
                                Profili İncele ➔
                            </a>
                            <button onclick="dismissSameSongToast('${key}')" class="btn-toast-close">
                                Kapat
                            </button>
                        </div>
                    `;

                    container.appendChild(toast);

                    setTimeout(() => {
                        dismissSameSongToast(key);
                    }, 16000);
                }

                window.dismissSameSongToast = function(key) {
                    dismissedMap.set(key, Date.now());
                    const toast = document.getElementById('toast_' + key);
                    if (toast) {
                        toast.classList.add('fade-out');
                        setTimeout(() => toast.remove(), 350);
                    }
                };

                async function checkSameSongListeners() {
                    try {
                        const res = await fetch('/live/listener-sync');
                        if (!res.ok) return;
                        const data = await res.json();
                        if (data.isPlaying && data.coListeners && data.coListeners.length > 0) {
                            for (const listener of data.coListeners) {
                                showSameSongToast(listener, data.trackName || listener.trackName, data.artists || listener.artists);
                            }
                        }
                    } catch (e) {}
                }

                setTimeout(checkSameSongListeners, 2000);
                setInterval(checkSameSongListeners, 6000);
            })();
        </script>
    }

    <footer>
        <p>&copy; @DateTime.Now.Year SpoMusic — Müzik Tabanlı Akıllı Eşleşme Platformu</p>
    </footer>

    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
