@{
    ViewData["Title"] = "Spotify ile Giriş Yap";
    var error = TempData["Error"]?.ToString();
}

<div style="max-width: 480px; margin: 4rem auto; padding: 0 1.5rem; text-align: center;">
    <div style="background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 3rem 2rem; box-shadow: 0 15px 40px rgba(0,0,0,0.6); position: relative; overflow: hidden;">
        
        <div style="position: absolute; top: -50px; right: -50px; width: 140px; height: 140px; background: rgba(29, 185, 84, 0.12); border-radius: 50%; filter: blur(40px); pointer-events: none;"></div>

        <div style="width: 72px; height: 72px; border-radius: 50%; background: var(--spotify-glow); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; color: var(--spotify-green);">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.58 14.42c-.18.3-.57.4-.87.21-2.4-1.47-5.43-1.8-9-1-.34.08-.68-.13-.76-.47-.08-.34.13-.68.47-.76 3.92-.89 7.28-.52 9.95 1.15.3.19.4.58.21.87zm1.22-2.72c-.23.37-.72.49-1.09.26-2.75-1.69-6.94-2.18-10.19-1.19-.42.13-.86-.11-.99-.53-.13-.42.11-.86.53-.99 3.71-1.13 8.35-.58 11.48 1.36.38.23.49.72.26 1.09zm.11-2.83C14.62 8.9 9.17 8.72 6.01 9.68c-.5.15-1.04-.13-1.19-.63-.15-.5.13-1.04.63-1.19 3.66-1.11 9.69-.9 13.5 1.36.46.27.61.87.34 1.33-.27.46-.87.61-1.38.32z"/>
            </svg>
        </div>

        <h2 style="font-size: 1.85rem; font-weight: 800; margin-bottom: 0.8rem; letter-spacing: -0.02em;">SpoMusic'e Bağlan</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 2rem;">
            Müzik zevkinize göre en uyumlu dinleyicileri keşfetmek ve ortak Blend listeleri oluşturmak için Spotify hesabınızla giriş yapın.
        </p>

        @if (!string.IsNullOrEmpty(error))
        {
            <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.35); color: #fca5a5; padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem; font-size: 0.9rem; text-align: left;">
                <div style="font-weight: 600; margin-bottom: 0.3rem;">⚠️ Giriş Uyarısı</div>
                <div>@error</div>
            </div>
        }

        <a asp-controller="Auth" asp-action="LoginSpotify" class="btn-spotify" style="width: 100%; justify-content: center; padding: 1rem; font-size: 1.05rem; box-shadow: 0 10px 25px rgba(29, 185, 84, 0.3);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.58 14.42c-.18.3-.57.4-.87.21-2.4-1.47-5.43-1.8-9-1-.34.08-.68-.13-.76-.47-.08-.34.13-.68.47-.76 3.92-.89 7.28-.52 9.95 1.15.3.19.4.58.21.87zm1.22-2.72c-.23.37-.72.49-1.09.26-2.75-1.69-6.94-2.18-10.19-1.19-.42.13-.86-.11-.99-.53-.13-.42.11-.86.53-.99 3.71-1.13 8.35-.58 11.48 1.36.38.23.49.72.26 1.09zm.11-2.83C14.62 8.9 9.17 8.72 6.01 9.68c-.5.15-1.04-.13-1.19-.63-.15-.5.13-1.04.63-1.19 3.66-1.11 9.69-.9 13.5 1.36.46.27.61.87.34 1.33-.27.46-.87.61-1.38.32z"/>
            </svg>
            Spotify ile Giriş Yap
        </a>

        <div style="margin-top: 1.8rem; padding: 1rem; background: rgba(255,255,255,0.02); border-radius: var(--radius-sm); border: 1px solid var(--border-subtle); text-align: left; font-size: 0.8rem; color: var(--text-muted); line-height: 1.5;">
            <div style="font-weight: 600; color: var(--text-main); margin-bottom: 0.3rem;">🔒 Güvenlik & Gizlilik</div>
            SpoMusic sadece dinleme geçmişinizi ve en sevdiğiniz parçaları analiz eder. Şifrenize asla erişmez ve üçüncü taraflarla paylaşmaz.
        </div>
    </div>
</div>
