@{
    ViewData["Title"] = "Müzik Zevkinin Ruh Eşini Keşfet";
}

<div class="hero-wrapper">
    <div class="hero-glow"></div>

    <div class="hero-badge">
        <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--spotify-green); display: inline-block;"></span>
        Akıllı Müzik Eşleşme Motoru v1.0
    </div>

    <h1 class="hero-title">
        Müzik Zevkinin <br />
        <span class="gradient-text">Ruh Eşini</span> Keşfet.
    </h1>

    <p class="hero-desc">
        SpoMusic; dinleme geçmişinizi, en sevdiğiniz sanatçıları ve güncel parçalarınızı analiz ederek sizinle aynı müzik frekansında olan insanları bulur.
    </p>

    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a asp-controller="Auth" asp-action="Login" class="btn-spotify" style="font-size: 1.05rem; padding: 0.85rem 2rem;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.58 14.42c-.18.3-.57.4-.87.21-2.4-1.47-5.43-1.8-9-1-.34.08-.68-.13-.76-.47-.08-.34.13-.68.47-.76 3.92-.89 7.28-.52 9.95 1.15.3.19.4.58.21.87zm1.22-2.72c-.23.37-.72.49-1.09.26-2.75-1.69-6.94-2.18-10.19-1.19-.42.13-.86-.11-.99-.53-.13-.42.11-.86.53-.99 3.71-1.13 8.35-.58 11.48 1.36.38.23.49.72.26 1.09zm.11-2.83C14.62 8.9 9.17 8.72 6.01 9.68c-.5.15-1.04-.13-1.19-.63-.15-.5.13-1.04.63-1.19 3.66-1.11 9.69-.9 13.5 1.36.46.27.61.87.34 1.33-.27.46-.87.61-1.38.32z"/>
            </svg>
            Spotify ile Bağlan
        </a>
        <a asp-controller="Matches" asp-action="Index" class="btn-outline-custom" style="font-size: 1.05rem; padding: 0.85rem 2rem;">
            Eşleşmeleri Gör &rarr;
        </a>
    </div>
</div>

<div class="feature-grid">
    <div class="feature-card">
        <div class="card-percent">40%</div>
        <h3>Ortak Parça Uyumu</h3>
        <p>En sevdiğiniz parçaların kesişim kümesi O(min(m,n)) karmaşıklığında gerçek zamanlı taranır.</p>
    </div>

    <div class="feature-card">
        <div class="card-percent" style="color: #34d399;">25%</div>
        <h3>Sanatçı Benzerliği</h3>
        <p>Farklı şarkılar dinleseniz dahi aynı müzisyenleri takip eden dinleyicileri yakalar.</p>
    </div>

    <div class="feature-card">
        <div class="card-percent" style="color: #38bdf8;">20%</div>
        <h3>Dinleme Güncelliği</h3>
        <p>Son 30 gün ve bugün içinde ortak dinlenen parçalar üstel ağırlıklandırmayla ekstra puan kazandırır.</p>
    </div>

    <div class="feature-card">
        <div class="card-percent" style="color: #a78bfa;">15%</div>
        <h3>Zevk Benzerliği</h3>
        <p>Top listelerinizin genel dağılım oranı üzerinden müzikal aura uyumunuz belirlenir.</p>
    </div>
</div>
